# RTL-SDR dongles (RTL2832U) openable without root. World-readable on purpose:
# this is a single-user handheld and the dongle only receives, and it avoids
# depending on which groups the home screen's service runs with.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", MODE="0666"
